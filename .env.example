# Core persistence
DATABASE_URL=postgres://user:password@localhost:5432/crypto_core?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
APP_SECRET=replace-with-a-stable-secret
OPS_LOG_COUNTERS=true

# Optional market-data service
PRICE_API_BASE_URL=

# EVM networks
ETH_RPC_URL=
BSC_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
EVM_RPC_URL=

# Bitcoin: leave BTC_HOST empty to use API/lite mode
BTC_HOST=
BTC_USER=
BTC_PASS=

# Solana and TON
SOLANA_RPC_URL=
TON_CONFIG_URL=

# TRON node and HTTP providers
TRON_GRPC_URL=grpc.trongrid.io:50051
TRON_GRPC_PROVIDERS=
TRON_HTTP_PROVIDERS=
TRON_PRO_API_KEY=

# TRON energy/rental providers
TRON_ENERGY_PROVIDER=trx_for_energy
TRON_ENERGY_API_KEY=
TRON_ENERGY_API_BASE_URL=
NETTS_API_KEY=
NETTS_API_BASE_URL=
NETTS_REAL_IP=
TRONRENTAL_API_KEY=
TRONRENTAL_API_BASE_URL=

# Optional sweep policy overrides
TRON_TOKEN_SWEEP_RESERVE_SUN=
TRON_PREFUND_TRANSFER_FEE_SUN=
TRON_TOKEN_SWEEP_MIN_BALANCE_SUN=
TRON_ENERGY_ACTIVATION_AMOUNT_SUN=
TRON_ENERGY_ORDER_DURATION_HOURS=
TRON_ENERGY_ORDER_TIMEOUT_SECONDS=
TRON_ENERGY_ORDER_TIMES=
TRON_ENERGY_AMOUNT_PER_TRANSFER=
SOLANA_FEE_ESTIMATE=
TON_FEE_ESTIMATE=
TON_JETTON_SWEEP_FEE=
